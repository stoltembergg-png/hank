{
  "testCommand": "node tools/run-all-tests.mjs",
  "testCommands": {
    "*": "node tools/run-feature-tests.mjs {feature}",
    "security-tests": "node tools/security/security-feature-tests.mjs",
    "tauri-desktop": "node --test tools/tauri-desktop-onp.test.mjs",
    "fuzz-tests": "node tools/security/fuzz-feature-tests.mjs",
    "load-tests": "node tools/security/load-feature-tests.mjs",
    "workflow-crash-recovery": "node tools/security/workflow-crash-recovery-feature-tests.mjs",
    "agent-loop-tests": "node tools/security/agent-loop-feature-tests.mjs",
    "auto-updater": "node tools/security/updater-feature-tests.mjs",
    "installers": "node tools/security/installer-feature-tests.mjs",
    "release-signing": "node tools/security/release-signing-feature-tests.mjs",
    "provider-compatibility-tests": "node tools/security/provider-compatibility-feature-tests.mjs",
    "evidence-scope-reconciliation": "node tools/security/evidence-scope-feature-tests.mjs"
  },
  "reporter": "exitcode",
  "reporters": {
    "remote-credential-isolation": "tap",
    "tauri-desktop": "tap",
    "security-tests": "tap",
    "fuzz-tests": "tap",
    "load-tests": "tap",
    "workflow-crash-recovery": "tap",
    "agent-loop-tests": "tap",
    "auto-updater": "tap",
    "installers": "tap",
    "release-signing": "tap",
    "provider-compatibility-tests": "tap",
    "evidence-scope-reconciliation": "tap"
  },
  "testGlobs": [
    "test/**/*.js",
    "test/**/*.mjs",
    "tests/**/*.rs",
    "crates/**/tests/**/*.rs",
    "**/*_test.rs",
    "**/tests.rs",
    "frontend/tests/**/*.test.ts",
    "frontend/tests/**/*.test.tsx",
    "apps/desktop/src-tauri/tests/**/*.rs",
    "tools/**/*.spec.mjs",
    "tools/**/*.spec.js",
    "test/release-prerelease.js"
  ],
  "srcGlobs": [
    "crates/**/src/**/*.rs",
    "src/**/*.rs",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "apps/desktop/src-tauri/src/**/*.rs",
    "tools/release-prerelease.mjs"
  ]
}
