{
  "testCommand": "node tools/run-all-tests.mjs",
  "reporter": "exitcode",
  "testGlobs": [
    "test/**/*.js",
    "tests/**/*.rs",
    "crates/**/tests/**/*.rs",
    "**/*_test.rs",
    "**/tests.rs",
    "frontend/tests/**/*.test.ts",
    "apps/desktop/src-tauri/tests/**/*.rs"
  ],
  "srcGlobs": [
    "crates/**/src/**/*.rs",
    "src/**/*.rs",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "apps/desktop/src-tauri/src/**/*.rs"
  ]
}
