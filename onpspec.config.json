{
  "testCommand": "node tools/run-all-tests.mjs",
  "testCommands": {
    "*": "node tools/run-feature-tests.mjs {feature}",
    "tauri-desktop": "node --test tools/tauri-desktop-onp.test.mjs"
  },
  "reporter": "exitcode",
  "reporters": {
    "remote-credential-isolation": "tap",
    "tauri-desktop": "tap"
  },
  "testGlobs": [
    "test/**/*.js",
    "test/**/*.mjs",
    "tests/**/*.rs",
    "crates/**/tests/**/*.rs",
    "**/*_test.rs",
    "**/tests.rs",
    "frontend/tests/**/*.test.ts",
    "frontend/tests/**/*.test.tsx",
    "apps/desktop/src-tauri/tests/**/*.rs",
    "test/release-prerelease.js"
  ],
  "srcGlobs": [
    "crates/**/src/**/*.rs",
    "src/**/*.rs",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "apps/desktop/src-tauri/src/**/*.rs",
    "tools/release-prerelease.mjs"
  ]
}
