{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hank://contracts/queue-card.schema.json",
  "title": "Hank Executable PR Card",
  "type": "object",
  "required": ["id", "category", "milestone", "title", "objective", "problem", "scope", "non_scope", "files", "dependencies", "functional_requirements", "nfrs", "acceptance", "tests", "security", "observability", "documentation", "definition_of_done", "unlock_condition"],
  "properties": {
    "id": {"type":"string", "pattern":"^PR-[0-9]{3}$"},
    "category": {"enum":["FOUNDATION","DOMAIN","INFRA","BACKEND","FRONTEND","SECURITY","TESTING","DEVOPS","DOCUMENTATION"]},
    "milestone": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1},
    "problem": {"type":"string","minLength":1},
    "scope": {"type":"string","minLength":1},
    "non_scope": {"type":"string","minLength":1},
    "files": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "dependencies": {"type":"array","items":{"type":"string","pattern":"^PR-[0-9]{3}$"}},
    "functional_requirements": {"type":"string","minLength":1},
    "nfrs": {"type":"string","minLength":1},
    "acceptance": {"type":"string","minLength":1},
    "tests": {"type":"string","minLength":1},
    "security": {"type":"string","minLength":1},
    "observability": {"type":"string","minLength":1},
    "documentation": {"type":"string","minLength":1},
    "definition_of_done": {"type":"string","minLength":1},
    "unlock_condition": {"type":"string","minLength":1}
  },
  "additionalProperties": false
}
