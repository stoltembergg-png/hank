{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hank://contracts/PR-EXECUTION-CONTRACT.schema.json",
  "title": "Hank PR Execution Contract",
  "type": "object",
  "required": ["card_id","repository","branch","worktree","base_sha","tree_sha","dirty_state","scope","non_goals","allowed_files","allowed_commands","author","reviewer","policy_revision","schema_revision","rollback"],
  "properties": {
    "card_id":{"type":"string","pattern":"^PR-[0-9]{3}$"},
    "repository":{"type":"string","minLength":1},
    "branch":{"type":"string","pattern":"^(?!main$)(?!master$).+"},
    "worktree":{"type":"string","minLength":1},
    "base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "tree_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "dirty_state":{"enum":["clean"]},
    "scope":{"type":"array","minItems":1,"items":{"type":"string"}},
    "non_goals":{"type":"array","items":{"type":"string"}},
    "allowed_files":{"type":"array","minItems":1,"items":{"type":"string"}},
    "allowed_commands":{"type":"array","items":{"type":"string"}},
    "author":{"type":"string","minLength":1},
    "reviewer":{"type":"string","minLength":1},
    "policy_revision":{"type":"string","minLength":1},
    "schema_revision":{"type":"string","minLength":1},
    "rollback":{"type":"string","minLength":1}
  },
  "additionalProperties": false
}
