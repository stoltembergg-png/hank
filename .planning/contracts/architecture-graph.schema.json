{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hank://contracts/architecture-graph.schema.json",
  "title": "Hank Architecture Graph",
  "type": "object",
  "required": ["schema_version", "layers", "edges", "forbidden_edges", "evidence_policy"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "owner", "responsibility", "allowed_dependencies", "process_lifecycle", "contract"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "allowed_dependencies": {"type": "array", "items": {"type": "string"}},
          "process_lifecycle": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "kind"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "kind": {"type": "string"}}, "additionalProperties": false}},
    "forbidden_edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "reason"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "evidence_policy": {"type": "object", "required": ["required_identity", "allowed_statuses"], "properties": {"required_identity": {"type": "array", "items": {"type": "string"}}, "allowed_statuses": {"type": "array", "items": {"enum": ["PASS", "FAIL", "BLOCKED", "NO_PROOF"]}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
